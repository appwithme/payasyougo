# Neon PostgreSQL connection string (pooled recommended for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# JWT signing secret (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Paystack test keys (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"
# With sk_test_ keys, driver withdrawals are simulated (Paystack Starter blocks Transfers).
# Set WITHDRAW_DEMO_MODE=true to force simulation even on live keys.
# WITHDRAW_DEMO_MODE=true

# API
PORT=4000
CORS_ORIGIN="*"

# Optional: public URL for webhook docs (ngrok during local Paystack testing)
# PUBLIC_API_URL="https://xxxx.ngrok-free.app"

# Google OAuth (passenger only)
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
