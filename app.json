{
  "expo": {
    "name": "PayAsYouGo",
    "slug": "payasyougo",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/app-icon-v4.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-v4.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF3F9"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.payasyougo.app"
    },
    "android": {
      "package": "com.payasyougo.app",
      "adaptiveIcon": {
        "backgroundColor": "#EEF3F9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/app-icon-v4.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "aee5d29c-249c-4473-826d-4358acb3d903"
      }
    }
  }
}
