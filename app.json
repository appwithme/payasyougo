{
  "expo": {
    "name": "PayAsYouGo",
    "slug": "payasyougo",
    "version": "1.0.2",
    "scheme": "payasyougo",
    "orientation": "portrait",
    "icon": "./assets/app-icon-v5.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-icon-v5.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.payasyougo.app"
    },
    "android": {
      "package": "com.payasyougo.app",
      "adaptiveIcon": {
        "backgroundColor": "#EEF3F9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/app-icon-v5.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PayAsYouGo to access your photos for profile pictures and Ghana Card uploads."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PayAsYouGo to scan driver QR codes and photograph Ghana Card documents."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#15233F"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "aee5d29c-249c-4473-826d-4358acb3d903"
      }
    }
  }
}
